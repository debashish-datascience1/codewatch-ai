# Get your FREE Groq API key at https://console.groq.com (no credit card required)
GROQ_API_KEY=your_groq_api_key_here

# Model — llama-3.3-70b-versatile is free and very capable
GROQ_MODEL=llama-3.3-70b-versatile

# Local ChromaDB persistence path
CHROMA_PERSIST_DIR=./chroma_db

# HuggingFace embedding model (runs locally, no API needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

LOG_LEVEL=INFO
